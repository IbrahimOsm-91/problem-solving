// Codewars - Convert number to sequence of bits
// 7 kyu

// extend all numbers with toBits()
Number.prototype.toBits = function(length) {
  const bits = this.toString(2)
  
  if (length === undefined) {
    const num = 8 - bits.length 
    return num >= 0
      ? '0'.repeat(num) + bits
      : bits
  }

  const num = length - bits.length
    return num >= 0
      ? '0'.repeat(num) + bits
      : bits
};
