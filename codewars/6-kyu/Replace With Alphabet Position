function alphabetPosition(text) {
  text = [...text.toUpperCase()]
  const resultArray = []
  
  text.forEach(letter => {
    const num = letter.charCodeAt(0) - 64
    
    if (num >= 1 && num <= 26) {
      resultArray.push(num)
    }
  })
  
  return (resultArray.join(" "))
}

