function solution(number){
  if (!number) return 0
  
  let result = 0
  
  for (let i = 0; i < number; i++) {
    if (i % 3 === 0 || i % 5 === 0) result += i
  }

  return result
}


/*
  This function loops through the numbers from 0 to one less than the given number
  and checks if each number is a multiple of 3 or 5.
  If it is, the function adds it to the result and returns the total
